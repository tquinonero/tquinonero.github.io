---
import Layout from '../layouts/base.astro';

const pageTitle = "Cron Expression Builder";
---

<Layout title={pageTitle}>
  <div class="bg-zinc-950 text-zinc-100 min-h-screen py-12">

    <!-- Header -->
    <div class="text-center mb-12 px-4">
      <div class="inline-flex items-center gap-2 bg-zinc-800 border border-zinc-700 rounded-full px-4 py-1.5 text-xs font-mono text-blue-400 mb-6 tracking-widest uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        Developer Tool
      </div>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Cron Expression Builder</h1>
      <p class="text-zinc-400 text-lg max-w-xl mx-auto">Build cron schedules visually, read them in plain English, and generate WP&#8209;Cron PHP snippets instantly.</p>
    </div>

    <div class="container-page grid lg:grid-cols-[440px_minmax(0,1fr)] gap-12">

      <!-- ─── LEFT: Builder Controls ──────────────────────────────── -->
      <aside class="space-y-6">

        <!-- WP Presets -->
        <div class="card">
          <div class="card-body">
            <h2 class="section-title">WordPress Presets</h2>
            <div class="grid grid-cols-2 gap-2 mt-3">
              <button class="preset-btn btn-secondary" data-expr="* * * * *">Every minute</button>
              <button class="preset-btn btn-secondary" data-expr="*/5 * * * *">Every 5 min</button>
              <button class="preset-btn btn-secondary" data-expr="0 * * * *">Hourly</button>
              <button class="preset-btn btn-secondary" data-expr="0 */12 * * *">Twice daily</button>
              <button class="preset-btn btn-secondary" data-expr="0 0 * * *">Daily midnight</button>
              <button class="preset-btn btn-secondary" data-expr="0 0 * * 1">Weekly (Mon)</button>
              <button class="preset-btn btn-secondary" data-expr="0 0 1 * *">Monthly (1st)</button>
              <button class="preset-btn btn-secondary" data-expr="30 9 * * 1-5">Weekdays 9:30 AM</button>
            </div>
          </div>
        </div>

        <!-- Raw Expression -->
        <div class="card">
          <div class="card-body">
            <h2 class="section-title">Raw Expression</h2>
            <p class="text-xs text-gray-500 mt-1 mb-2">Paste an existing expression to parse and visualise it</p>
            <div class="flex gap-2">
              <input id="raw-input" type="text" placeholder="0 0 * * *" class="form-input font-mono" spellcheck="false" autocomplete="off" />
              <button id="btn-parse" class="btn-primary whitespace-nowrap">Parse</button>
            </div>
          </div>
        </div>

        <!-- MINUTE -->
        <div class="card">
          <div class="card-body">
            <div class="flex items-baseline justify-between">
              <h2 class="section-title">Minute</h2>
              <span class="text-xs text-gray-400">0 – 59</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-3 mb-3">
              <button class="mode-btn active" data-field="minute" data-mode="every">Every</button>
              <button class="mode-btn" data-field="minute" data-mode="everyN">Every N</button>
              <button class="mode-btn" data-field="minute" data-mode="specific">Specific</button>
              <button class="mode-btn" data-field="minute" data-mode="range">Range</button>
            </div>
            <div id="minute-inputs" class="space-y-2"></div>
            <div class="mt-2 font-mono text-xs text-blue-400 field-preview">→ <span id="minute-preview">*</span></div>
          </div>
        </div>

        <!-- HOUR -->
        <div class="card">
          <div class="card-body">
            <div class="flex items-baseline justify-between">
              <h2 class="section-title">Hour</h2>
              <span class="text-xs text-gray-400">0 – 23</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-3 mb-3">
              <button class="mode-btn active" data-field="hour" data-mode="every">Every</button>
              <button class="mode-btn" data-field="hour" data-mode="everyN">Every N</button>
              <button class="mode-btn" data-field="hour" data-mode="specific">Specific</button>
              <button class="mode-btn" data-field="hour" data-mode="range">Range</button>
            </div>
            <div id="hour-inputs" class="space-y-2"></div>
            <div class="mt-2 font-mono text-xs text-blue-400 field-preview">→ <span id="hour-preview">*</span></div>
          </div>
        </div>

        <!-- DAY OF MONTH -->
        <div class="card">
          <div class="card-body">
            <div class="flex items-baseline justify-between">
              <h2 class="section-title">Day of Month</h2>
              <span class="text-xs text-gray-400">1 – 31</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-3 mb-3">
              <button class="mode-btn active" data-field="dom" data-mode="every">Every</button>
              <button class="mode-btn" data-field="dom" data-mode="everyN">Every N</button>
              <button class="mode-btn" data-field="dom" data-mode="specific">Specific</button>
              <button class="mode-btn" data-field="dom" data-mode="range">Range</button>
            </div>
            <div id="dom-inputs" class="space-y-2"></div>
            <div class="mt-2 font-mono text-xs text-blue-400 field-preview">→ <span id="dom-preview">*</span></div>
          </div>
        </div>

        <!-- MONTH -->
        <div class="card">
          <div class="card-body">
            <div class="flex items-baseline justify-between">
              <h2 class="section-title">Month</h2>
              <span class="text-xs text-gray-400">1 – 12</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-3 mb-3">
              <button class="mode-btn active" data-field="month" data-mode="every">Every</button>
              <button class="mode-btn" data-field="month" data-mode="everyN">Every N</button>
              <button class="mode-btn" data-field="month" data-mode="specific">Specific</button>
              <button class="mode-btn" data-field="month" data-mode="range">Range</button>
            </div>
            <div id="month-inputs" class="space-y-2"></div>
            <div class="mt-2 font-mono text-xs text-blue-400 field-preview">→ <span id="month-preview">*</span></div>
          </div>
        </div>

        <!-- DAY OF WEEK -->
        <div class="card">
          <div class="card-body">
            <div class="flex items-baseline justify-between">
              <h2 class="section-title">Day of Week</h2>
              <span class="text-xs text-gray-400">0 = Sun · 6 = Sat</span>
            </div>
            <div class="flex flex-wrap gap-1.5 mt-3 mb-3">
              <button class="mode-btn active" data-field="dow" data-mode="every">Every</button>
              <button class="mode-btn" data-field="dow" data-mode="everyN">Every N</button>
              <button class="mode-btn" data-field="dow" data-mode="specific">Specific</button>
              <button class="mode-btn" data-field="dow" data-mode="range">Range</button>
            </div>
            <div id="dow-inputs" class="space-y-2"></div>
            <div class="mt-2 font-mono text-xs text-blue-400 field-preview">→ <span id="dow-preview">*</span></div>
          </div>
        </div>

      </aside>

      <!-- ─── RIGHT: Output Panel ──────────────────────────────────── -->
      <main class="space-y-6 sticky top-10 self-start">

        <!-- Cron Expression Display -->
        <div class="card overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b bg-gray-50">
            <span class="text-sm font-medium text-gray-900">Cron Expression</span>
            <div class="flex gap-2">
              <button id="btn-reset" class="btn-secondary">Reset</button>
              <button id="btn-copy-expr" class="btn-primary">Copy</button>
            </div>
          </div>
          <div class="px-6 pt-6 pb-4 bg-gray-950">
            <div class="flex gap-4 font-mono text-2xl font-bold" id="expr-display">
              <div class="text-center">
                <div id="part-minute" class="part-minute">*</div>
                <div class="text-xs text-gray-500 mt-1 tracking-widest">MIN</div>
              </div>
              <div class="text-center">
                <div id="part-hour" class="part-hour">*</div>
                <div class="text-xs text-gray-500 mt-1 tracking-widest">HOUR</div>
              </div>
              <div class="text-center">
                <div id="part-dom" class="part-dom">*</div>
                <div class="text-xs text-gray-500 mt-1 tracking-widest">DOM</div>
              </div>
              <div class="text-center">
                <div id="part-month" class="part-month">*</div>
                <div class="text-xs text-gray-500 mt-1 tracking-widest">MON</div>
              </div>
              <div class="text-center">
                <div id="part-dow" class="part-dow">*</div>
                <div class="text-xs text-gray-500 mt-1 tracking-widest">DOW</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Plain English -->
        <div class="card">
          <div class="card-body">
            <p class="section-title">In plain English</p>
            <p id="human-readable" class="text-gray-800 text-sm mt-2 leading-relaxed">Runs every minute.</p>
          </div>
        </div>

        <!-- Next 5 Runs -->
        <div class="card">
          <div class="card-body">
            <p class="section-title">Next 5 runs</p>
            <ul id="next-runs" class="mt-2 space-y-1 text-sm font-mono text-gray-700"></ul>
          </div>
        </div>

        <!-- WP-Cron PHP Snippet -->
        <div class="card overflow-hidden">
          <div class="flex items-center justify-between px-6 py-4 border-b bg-gray-50">
            <span class="text-sm font-medium text-gray-900">WP&#8209;Cron PHP Snippet</span>
            <button id="btn-copy-php" class="btn-secondary">Copy PHP</button>
          </div>
          <pre class="p-6 text-xs bg-gray-950 text-gray-100 overflow-x-auto leading-relaxed"><code id="php-snippet"></code></pre>
          <div id="wp-schedule-note" class="note-box"></div>
        </div>

      </main>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 bg-zinc-800 border border-zinc-600 text-zinc-100 text-sm px-4 py-2 rounded shadow-lg opacity-0 translate-y-4 transition-all duration-200 pointer-events-none">
    Copied!
  </div>

  <script type="module">
    // ── Constants ────────────────────────────────────────────────────────────
    const FIELDS      = ['minute', 'hour', 'dom', 'month', 'dow'];
    const MONTH_ABB   = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const MONTH_FULL  = ['', 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const DOW_ABB     = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    const DOW_FULL    = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

    // field min/max for range inputs and wildcard-step normalization
    const FIELD_META = {
      minute: { min: 0, max: 59, unit: 'minute(s)' },
      hour:   { min: 0, max: 23, unit: 'hour(s)'   },
      dom:    { min: 1, max: 31, unit: 'day(s)'     },
      month:  { min: 1, max: 12, unit: 'month(s)'   },
      dow:    { min: 0, max: 6,  unit: 'day(s)'     },
    };

    /** @typedef {{ mode: string, n: number, values: number[], from: number, to: number, step: number }} FieldState */

    // ── State ────────────────────────────────────────────────────────────────
    /** @type {Record<string, FieldState>} */
    const state = {
      minute: { mode: 'every', n: 5,  values: [], from: 0, to: 30, step: 1 },
      hour:   { mode: 'every', n: 2,  values: [], from: 9, to: 17, step: 1 },
      dom:    { mode: 'every', n: 2,  values: [], from: 1, to: 15, step: 1 },
      month:  { mode: 'every', n: 3,  values: [], from: 1, to: 6,  step: 1 },
      dow:    { mode: 'every', n: 1,  values: [], from: 1, to: 5,  step: 1 },
    };

    // ── Field → cron expression part ─────────────────────────────────────────
    function fieldToExpr(f) {
      switch (f.mode) {
        case 'every':    return '*';
        case 'everyN':   return `*/${f.n}`;
        case 'specific': {
          const sorted = f.values.slice().sort((a, b) => a - b);
          return sorted.length ? sorted.join(',') : '*';
        }
        case 'range':
          return f.step > 1 ? `${f.from}-${f.to}/${f.step}` : `${f.from}-${f.to}`;
        default:         return '*';
      }
    }

    function getExpression() {
      return FIELDS.map(f => fieldToExpr(state[f])).join(' ');
    }

    // ── Master refresh ────────────────────────────────────────────────────────
    function refresh() {
      const expr  = getExpression();
      const parts = expr.split(' ');

      // Update expression display
      FIELDS.forEach((f, i) => {
        document.getElementById(`part-${f}`).textContent   = parts[i];
        document.getElementById(`${f}-preview`).textContent = parts[i];
      });

      // Sync raw input
      document.getElementById('raw-input').value = expr;

      // Outputs
      document.getElementById('human-readable').textContent = describeExpression(expr);
      renderNextRuns(expr);
      renderPhpSnippet(expr);
    }

    // ── Human-readable description ────────────────────────────────────────────
    function formatHour(h) {
      if (h === 0)  return '12:00 AM';
      if (h === 12) return '12:00 PM';
      if (h < 12)   return `${h}:00 AM`;
      return `${h - 12}:00 PM`;
    }

    function ordinalize(n) {
      const s = ['th', 'st', 'nd', 'rd'];
      const v = n % 100;
      return n + (s[(v - 20) % 10] || s[v] || s[0]);
    }

    function describeExprPart(part, field) {
      if (part === '*') return null; // covered by base sentence

      if (/^\*\/\d+$/.test(part)) {
        const step = parseInt(part.slice(2));
        const unit = { minute: 'minute', hour: 'hour', dom: 'day', month: 'month', dow: 'day' }[field];
        return step === 1 ? null : `every ${step} ${unit}s`;
      }

      if (/^\d+(,\d+)+$/.test(part)) {
        const vals = part.split(',').map(Number);
        if (field === 'hour')  return `at ${vals.map(formatHour).join(', ')}`;
        if (field === 'month') return `in ${vals.map(m => MONTH_FULL[m]).join(', ')}`;
        if (field === 'dow')   return `on ${vals.map(d => DOW_FULL[d]).join(', ')}`;
        if (field === 'dom')   return `on the ${vals.map(ordinalize).join(', ')}`;
        return `at minute${vals.length > 1 ? 's' : ''} ${vals.join(', ')}`;
      }

      if (/^\d+-\d+(\/\d+)?$/.test(part)) {
        const m = part.match(/^(\d+)-(\d+)(?:\/(\d+))?$/);
        const [from, to, step] = [+m[1], +m[2], m[3] ? +m[3] : 1];
        if (field === 'hour')  return `every${step > 1 ? ` ${step}` : ''} hour between ${formatHour(from)} and ${formatHour(to)}`;
        if (field === 'month') return `from ${MONTH_FULL[from]} to ${MONTH_FULL[to]}${step > 1 ? ` every ${step} months` : ''}`;
        if (field === 'dow')   return `from ${DOW_FULL[from]} through ${DOW_FULL[to]}`;
        if (field === 'dom')   return `from day ${from} to ${to}${step > 1 ? ` every ${step} days` : ''}`;
        return `from minute ${from} to ${to}${step > 1 ? ` every ${step}` : ''}`;
      }

      if (/^\d+$/.test(part)) {
        if (field === 'hour')  return `at ${formatHour(+part)}`;
        if (field === 'minute') return `at minute ${part}`;
        if (field === 'month') return `in ${MONTH_FULL[+part]}`;
        if (field === 'dow')   return `on ${DOW_FULL[+part]}`;
        if (field === 'dom')   return `on the ${ordinalize(+part)}`;
      }

      return null;
    }

    function describeExpression(expr) {
      const [min, hour, dom, month, dow] = expr.split(' ');

      // Base frequency (minute part)
      let sentence = '';
      if (min === '*')             sentence = 'every minute';
      else if (min === '*/1')      sentence = 'every minute';
      else if (/^\*\/\d+$/.test(min)) sentence = `every ${min.slice(2)} minutes`;
      else if (/^\d+$/.test(min))  sentence = `at minute ${min}`;
      else if (/^\d+,/.test(min))  sentence = `at minutes ${min}`;
      else                         sentence = `at minute ${min}`;

      // Append rest
      const hourDesc  = describeExprPart(hour,  'hour');
      const domDesc   = describeExprPart(dom,   'dom');
      const monthDesc = describeExprPart(month, 'month');
      const dowDesc   = describeExprPart(dow,   'dow');

      if (hourDesc)  sentence += `, ${hourDesc}`;
      if (domDesc)   sentence += `, ${domDesc}`;
      if (monthDesc) sentence += `, ${monthDesc}`;
      if (dowDesc)   sentence += `, ${dowDesc}`;

      return sentence.charAt(0).toUpperCase() + sentence.slice(1) + '.';
    }

    // ── Next runs calculator ──────────────────────────────────────────────────
    function matchesExprPart(val, part, fieldMin) {
      if (part === '*') return true;

      if (part.startsWith('*/')) {
        const step = parseInt(part.slice(2));
        return (val - fieldMin) % step === 0;
      }

      // range with optional step: from-to/step
      if (part.includes('-')) {
        const [rangeStr, stepStr] = part.split('/');
        const [from, to] = rangeStr.split('-').map(Number);
        const step = stepStr ? parseInt(stepStr) : 1;
        if (val < from || val > to) return false;
        return (val - from) % step === 0;
      }

      // list
      if (part.includes(',')) {
        return part.split(',').map(Number).includes(val);
      }

      return parseInt(part) === val;
    }

    function getNextRuns(expr, count = 5) {
      const parts = expr.split(' ');
      if (parts.length !== 5) return [];
      const [minE, hourE, domE, monthE, dowE] = parts;

      const results = [];
      let d = new Date();
      d.setSeconds(0, 0);
      d = new Date(d.getTime() + 60_000); // start from the next minute

      const limit = new Date(d.getTime() + 366 * 24 * 60 * 60 * 1000);

      while (results.length < count && d < limit) {
        if (
          matchesExprPart(d.getMinutes(),   minE,   0) &&
          matchesExprPart(d.getHours(),     hourE,  0) &&
          matchesExprPart(d.getDate(),      domE,   1) &&
          matchesExprPart(d.getMonth() + 1, monthE, 1) &&
          matchesExprPart(d.getDay(),       dowE,   0)
        ) {
          results.push(new Date(d));
        }
        d = new Date(d.getTime() + 60_000);
      }
      return results;
    }

    function renderNextRuns(expr) {
      const runs = getNextRuns(expr);
      const ul   = document.getElementById('next-runs');

      if (!runs.length) {
        ul.innerHTML = '<li class="text-gray-400 not-italic">No matching run found within the next year.</li>';
        return;
      }

      ul.innerHTML = runs.map(d =>
        `<li>${d.toLocaleString('en-GB', {
          weekday: 'short', year: 'numeric', month: 'short',
          day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false
        })}</li>`
      ).join('');
    }

    // ── WP-Cron PHP snippet ───────────────────────────────────────────────────
    /** Built-in WordPress schedules: name → canonical cron expression */
    const WP_BUILT_IN = {
      'hourly':     '0 * * * *',
      'twicedaily': '0 */12 * * *',
      'daily':      '0 0 * * *',
      'weekly':     '0 0 * * 0',
    };

    function getWpScheduleName(expr) {
      for (const [name, canonical] of Object.entries(WP_BUILT_IN)) {
        if (canonical === expr) return name;
      }
      return null;
    }

    /** Best-effort: derive interval in seconds from simple expressions. */
    function estimateInterval(expr) {
      const [min, hour, dom, month, dow] = expr.split(' ');
      const everyN = (part) => /^\*\/\d+$/.test(part) ? parseInt(part.slice(2)) : null;
      const fixed  = (part) => /^\d+$/.test(part) ? parseInt(part) : null;

      if (min === '*' && hour === '*' && dom === '*' && month === '*' && dow === '*')
        return 60;
      if (everyN(min) && hour === '*' && dom === '*' && month === '*' && dow === '*')
        return everyN(min) * 60;
      if (fixed(min) !== null && everyN(hour) && dom === '*' && month === '*' && dow === '*')
        return everyN(hour) * 3600;
      if (fixed(min) !== null && fixed(hour) !== null && dom === '*' && month === '*' && dow === '*')
        return 86400; // once a day
      if (fixed(min) !== null && fixed(hour) !== null && dom === '*' && month === '*' && fixed(dow) !== null)
        return 86400 * 7; // once a week
      return null;
    }

    function formatInterval(s) {
      if (s < 60)    return `${s} second${s !== 1 ? 's' : ''}`;
      if (s < 3600)  return `${s / 60} minute${s / 60 !== 1 ? 's' : ''}`;
      if (s < 86400) return `${s / 3600} hour${s / 3600 !== 1 ? 's' : ''}`;
      return `${s / 86400} day${s / 86400 !== 1 ? 's' : ''}`;
    }

    function renderPhpSnippet(expr) {
      const builtIn  = getWpScheduleName(expr);
      const interval = estimateInterval(expr);

      let schedule, extraCode, note;

      if (builtIn) {
        schedule  = builtIn;
        extraCode = '';
        note      = `
          <p class="note-title">✓ Uses a built-in WordPress schedule</p>
          <p>WordPress recognises <code>'${builtIn}'</code> out of the box — no extra code is needed to register an interval.</p>
          <p class="note-caveat">⚠ <strong>Timing is approximate.</strong> WP-Cron only fires when someone visits the site. If no page loads happen at the scheduled time, the task runs at the next visit after that point. For exact timing, add <code>define('DISABLE_WP_CRON', true);</code> to <code>wp-config.php</code> and trigger <code>wp-cron.php</code> via a real server cron job instead.</p>
          <p class="note-links-heading">Official documentation</p>
          <ul class="note-links">
            <li><a href="https://developer.wordpress.org/reference/functions/wp_schedule_event/" target="_blank" rel="noopener">wp_schedule_event()</a> — schedules a recurring event</li>
            <li><a href="https://developer.wordpress.org/reference/functions/wp_next_scheduled/" target="_blank" rel="noopener">wp_next_scheduled()</a> — prevents duplicate events</li>
            <li><a href="https://developer.wordpress.org/reference/functions/wp_clear_scheduled_hook/" target="_blank" rel="noopener">wp_clear_scheduled_hook()</a> — cleans up on plugin deactivation</li>
            <li><a href="https://developer.wordpress.org/plugins/cron/hooking-wp-cron-into-the-system-task-scheduler/" target="_blank" rel="noopener">Hooking WP-Cron into the system task scheduler</a> — for precise timing</li>
          </ul>
        `;
      } else if (interval) {
        schedule  = 'my_custom_schedule';
        note      = `
          <p class="note-title">ℹ Custom interval required</p>
          <p>WordPress only has four built-in schedules: <code>hourly</code>, <code>twicedaily</code>, <code>daily</code>, and <code>weekly</code>. Your expression doesn't match any of them, so the snippet registers a custom one (every ${formatInterval(interval)}) using the <code>cron_schedules</code> filter.</p>
          <p><strong>Order matters:</strong> the <code>cron_schedules</code> filter must run <em>before</em> <code>wp_schedule_event()</code> is called — otherwise WordPress won't recognise the schedule name and will silently fail. The snippet above handles this correctly: the filter is hooked on every load, and the event is only registered once on plugin activation.</p>
          <p class="note-caveat">⚠ <strong>Timing is approximate.</strong> WP-Cron only fires when someone visits the site, not on a real clock. For exact timing, add <code>define('DISABLE_WP_CRON', true);</code> to <code>wp-config.php</code> and use a real server cron job to call <code>wp-cron.php</code> directly.</p>
          <p class="note-links-heading">Official documentation</p>
          <ul class="note-links">
            <li><a href="https://developer.wordpress.org/reference/hooks/cron_schedules/" target="_blank" rel="noopener">cron_schedules filter</a> — how to register custom intervals</li>
            <li><a href="https://developer.wordpress.org/reference/functions/wp_schedule_event/" target="_blank" rel="noopener">wp_schedule_event()</a> — schedules a recurring event</li>
            <li><a href="https://developer.wordpress.org/reference/functions/wp_clear_scheduled_hook/" target="_blank" rel="noopener">wp_clear_scheduled_hook()</a> — cleans up on plugin deactivation</li>
            <li><a href="https://developer.wordpress.org/plugins/cron/understanding-wp-cron-scheduling/" target="_blank" rel="noopener">Understanding WP-Cron scheduling</a> — how intervals and queuing work</li>
            <li><a href="https://developer.wordpress.org/plugins/cron/hooking-wp-cron-into-the-system-task-scheduler/" target="_blank" rel="noopener">Hooking WP-Cron into the system task scheduler</a> — for precise timing</li>
          </ul>
        `;
        extraCode =
`// Register custom schedule interval (must be added before wp_schedule_event)
add_filter( 'cron_schedules', function ( array $schedules ): array {
    $schedules['my_custom_schedule'] = [
        'interval' => ${interval},
        'display'  => __( 'Custom: every ${formatInterval(interval)}' ),
    ];
    return $schedules;
} );

`;
      } else {
        schedule  = 'my_custom_schedule';
        note      = `
          <p class="note-title">✗ This expression cannot be used with WP-Cron</p>
          <p>WP-Cron is <strong>interval-based</strong>, not cron-syntax-based. It works by saying "run again every N seconds" — it has no concept of "run only on weekdays" or "run on the 15th of specific months". Your expression has no equivalent fixed interval, so WP-Cron cannot replicate it faithfully.</p>
          <p><strong>Recommended approach:</strong> use a real server cron job. Add <code>define('DISABLE_WP_CRON', true);</code> to <code>wp-config.php</code> to stop WP-Cron from running on page load, then add a system-level cron entry:</p>
          <pre class="note-code">${expr}    curl -s https://yourdomain.com/wp-cron.php?doing_wp_cron</pre>
          <p>The PHP snippet above includes a best-effort WP-Cron fallback in case you still want one, but the server cron approach is the correct solution here.</p>
          <p class="note-links-heading">Official documentation</p>
          <ul class="note-links">
            <li><a href="https://developer.wordpress.org/plugins/cron/understanding-wp-cron-scheduling/" target="_blank" rel="noopener">Understanding WP-Cron scheduling</a> — explains why it is interval-based</li>
            <li><a href="https://developer.wordpress.org/plugins/cron/hooking-wp-cron-into-the-system-task-scheduler/" target="_blank" rel="noopener">Hooking WP-Cron into the system task scheduler</a> — the recommended approach for this case</li>
            <li><a href="https://developer.wordpress.org/reference/functions/wp_clear_scheduled_hook/" target="_blank" rel="noopener">wp_clear_scheduled_hook()</a> — cleans up on plugin deactivation</li>
          </ul>
        `;
        extraCode =
`// WP-Cron cannot replicate this expression exactly (it is interval-based).
// Recommended: use a real server cron instead:
//   ${expr}   curl -s https://yourdomain.com/wp-cron.php?doing_wp_cron
//
// In wp-config.php, add: define( 'DISABLE_WP_CRON', true );
//
// If you still want WP-Cron, register a best-effort interval below:
add_filter( 'cron_schedules', function ( array $schedules ): array {
    $schedules['my_custom_schedule'] = [
        'interval' => HOUR_IN_SECONDS, // adjust to suit
        'display'  => __( 'Custom Schedule' ),
    ];
    return $schedules;
} );

`;
      }

      const php =
`<?php
${extraCode}// 1. Hook your callback
add_action( 'my_scheduled_hook', 'my_scheduled_callback' );

function my_scheduled_callback(): void {
    // Your code here
}

// 2. Schedule the event on plugin activation
register_activation_hook( __FILE__, 'my_plugin_activate' );

function my_plugin_activate(): void {
    if ( ! wp_next_scheduled( 'my_scheduled_hook' ) ) {
        wp_schedule_event( time(), '${schedule}', 'my_scheduled_hook' );
    }
}

// 3. Clean up on plugin deactivation (required)
register_deactivation_hook( __FILE__, 'my_plugin_deactivate' );

function my_plugin_deactivate(): void {
    wp_clear_scheduled_hook( 'my_scheduled_hook' );
}`;

      document.getElementById('php-snippet').textContent = php;
      document.getElementById('wp-schedule-note').innerHTML = note;
      document.getElementById('wp-schedule-note').style.display = 'block';
    }

    // ── Render field-specific inputs ──────────────────────────────────────────
    function renderFieldInputs(fieldName) {
      const f         = state[fieldName];
      const container = document.getElementById(`${fieldName}-inputs`);
      container.innerHTML = '';

      if (f.mode === 'every') {
        container.innerHTML = '<p class="text-xs text-gray-400">Matches every value in the allowed range.</p>';
        return;
      }

      if (f.mode === 'everyN') {
        const { min, max, unit } = FIELD_META[fieldName];
        const wrap = document.createElement('div');
        wrap.className = 'flex items-center gap-2';
        wrap.innerHTML = `
          <label class="text-xs text-gray-600 whitespace-nowrap">Every</label>
          <input type="number" id="${fieldName}-n"
            class="form-input w-24" min="2" max="${max - min}"
            value="${f.n}" />
          <label class="text-xs text-gray-600 whitespace-nowrap">${unit}</label>`;
        container.appendChild(wrap);

        document.getElementById(`${fieldName}-n`).addEventListener('input', e => {
          state[fieldName].n = Math.max(2, parseInt(e.target.value) || 2);
          syncPreviewAndRefresh(fieldName);
        });
        return;
      }

      if (f.mode === 'specific') {
        // Hour → 24 toggle buttons (6 columns)
        if (fieldName === 'hour') {
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-6 gap-1';
          for (let h = 0; h < 24; h++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `toggle-btn${f.values.includes(h) ? ' selected' : ''}`;
            btn.textContent = h.toString().padStart(2, '0');
            btn.addEventListener('click', () => {
              toggleValue(fieldName, h);
              renderFieldInputs(fieldName);
              syncPreviewAndRefresh(fieldName);
            });
            grid.appendChild(btn);
          }
          container.appendChild(grid);
          return;
        }

        // Month → 12 toggle buttons with abbreviations (4 columns)
        if (fieldName === 'month') {
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-4 gap-1';
          for (let m = 1; m <= 12; m++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `toggle-btn${f.values.includes(m) ? ' selected' : ''}`;
            btn.textContent = MONTH_ABB[m];
            btn.addEventListener('click', () => {
              toggleValue(fieldName, m);
              renderFieldInputs(fieldName);
              syncPreviewAndRefresh(fieldName);
            });
            grid.appendChild(btn);
          }
          container.appendChild(grid);
          return;
        }

        // DOW → 7 toggle buttons (all in one row)
        if (fieldName === 'dow') {
          const grid = document.createElement('div');
          grid.className = 'grid grid-cols-7 gap-1';
          for (let d = 0; d < 7; d++) {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = `toggle-btn${f.values.includes(d) ? ' selected' : ''}`;
            btn.textContent = DOW_ABB[d];
            btn.addEventListener('click', () => {
              toggleValue(fieldName, d);
              renderFieldInputs(fieldName);
              syncPreviewAndRefresh(fieldName);
            });
            grid.appendChild(btn);
          }
          container.appendChild(grid);
          return;
        }

        // Minute / DOM → text input
        const placeholder = fieldName === 'minute' ? '0,15,30,45' : '1,15,31';
        const wrap = document.createElement('div');
        wrap.innerHTML = `
          <input type="text" id="${fieldName}-values"
            class="form-input font-mono"
            placeholder="${placeholder}"
            value="${f.values.join(',')}" />
          <p class="text-xs text-gray-400 mt-1">Comma-separated values</p>`;
        container.appendChild(wrap);

        document.getElementById(`${fieldName}-values`).addEventListener('input', e => {
          const vals = e.target.value.split(',')
            .map(v => parseInt(v.trim()))
            .filter(v => !isNaN(v));
          state[fieldName].values = vals;
          syncPreviewAndRefresh(fieldName);
        });
        return;
      }

      if (f.mode === 'range') {
        const { min: fMin, max: fMax } = FIELD_META[fieldName];
        const wrap = document.createElement('div');
        wrap.innerHTML = `
          <div class="grid grid-cols-3 gap-2">
            <div>
              <label class="text-xs text-gray-600">From</label>
              <input type="number" id="${fieldName}-from"
                class="form-input mt-1" min="${fMin}" max="${fMax}"
                value="${f.from}" />
            </div>
            <div>
              <label class="text-xs text-gray-600">To</label>
              <input type="number" id="${fieldName}-to"
                class="form-input mt-1" min="${fMin}" max="${fMax}"
                value="${f.to}" />
            </div>
            <div>
              <label class="text-xs text-gray-600">Step</label>
              <input type="number" id="${fieldName}-step"
                class="form-input mt-1" min="1" max="${fMax}"
                value="${f.step}" />
            </div>
          </div>
          <p class="text-xs text-gray-400 mt-1">Step defaults to 1 (every value in range)</p>`;
        container.appendChild(wrap);

        ['from', 'to', 'step'].forEach(part => {
          document.getElementById(`${fieldName}-${part}`).addEventListener('input', e => {
            const def = part === 'step' ? 1 : FIELD_META[fieldName].min;
            state[fieldName][part] = parseInt(e.target.value) ?? def;
            syncPreviewAndRefresh(fieldName);
          });
        });
      }
    }

    function toggleValue(fieldName, val) {
      const idx = state[fieldName].values.indexOf(val);
      if (idx >= 0) state[fieldName].values.splice(idx, 1);
      else          state[fieldName].values.push(val);
    }

    function syncPreviewAndRefresh(fieldName) {
      document.getElementById(`${fieldName}-preview`).textContent = fieldToExpr(state[fieldName]);
      refresh();
    }

    // ── Mode buttons ──────────────────────────────────────────────────────────
    document.querySelectorAll('.mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const field = btn.dataset.field;
        const mode  = btn.dataset.mode;

        document.querySelectorAll(`.mode-btn[data-field="${field}"]`)
          .forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        state[field].mode   = mode;
        state[field].values = [];

        renderFieldInputs(field);
        syncPreviewAndRefresh(field);
      });
    });

    // ── Preset buttons ────────────────────────────────────────────────────────
    document.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        parseAndApply(btn.dataset.expr);
      });
    });

    // ── Parse raw expression ──────────────────────────────────────────────────
    document.getElementById('btn-parse').addEventListener('click', () => {
      parseAndApply(document.getElementById('raw-input').value.trim());
    });

    document.getElementById('raw-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') parseAndApply(e.target.value.trim());
    });

    function parseAndApply(expr) {
      const parts = expr.trim().split(/\s+/);
      if (parts.length !== 5) return;

      parts.forEach((part, i) => {
        const field = FIELDS[i];
        const s     = state[field];

        if (part === '*') {
          s.mode = 'every';
        } else if (/^\*\/\d+$/.test(part)) {
          s.mode = 'everyN';
          s.n    = parseInt(part.slice(2));
        } else if (/^\d+(,\d+)+$/.test(part)) {
          s.mode   = 'specific';
          s.values = part.split(',').map(Number);
        } else if (/^\d+-\d+(\/\d+)?$/.test(part)) {
          const m  = part.match(/^(\d+)-(\d+)(?:\/(\d+))?$/);
          s.mode   = 'range';
          s.from   = parseInt(m[1]);
          s.to     = parseInt(m[2]);
          s.step   = m[3] ? parseInt(m[3]) : 1;
        } else if (/^\d+$/.test(part)) {
          s.mode   = 'specific';
          s.values = [parseInt(part)];
        } else {
          s.mode = 'every';
        }

        // Sync mode buttons
        document.querySelectorAll(`.mode-btn[data-field="${field}"]`)
          .forEach(b => b.classList.remove('active'));
        const activeBtn = document.querySelector(
          `.mode-btn[data-field="${field}"][data-mode="${s.mode}"]`
        );
        if (activeBtn) activeBtn.classList.add('active');

        renderFieldInputs(field);
      });

      refresh();
    }

    // ── Copy helpers ──────────────────────────────────────────────────────────
    function showToast(btnId, tempText) {
      const btn  = document.getElementById(btnId);
      const orig = btn.textContent;
      btn.textContent = tempText;

      const toast = document.getElementById('toast');
      toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');

      setTimeout(() => {
        btn.textContent = orig;
        toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2000);
    }

    document.getElementById('btn-copy-expr').addEventListener('click', () => {
      navigator.clipboard.writeText(getExpression()).then(() => showToast('btn-copy-expr', 'Copied!'));
    });

    document.getElementById('btn-copy-php').addEventListener('click', () => {
      const code = document.getElementById('php-snippet').textContent || '';
      navigator.clipboard.writeText(code).then(() => showToast('btn-copy-php', 'Copied!'));
    });

    // ── Reset ─────────────────────────────────────────────────────────────────
    document.getElementById('btn-reset').addEventListener('click', () => {
      const defaults = {
        minute: { mode: 'every', n: 5,  values: [], from: 0,  to: 30, step: 1 },
        hour:   { mode: 'every', n: 2,  values: [], from: 9,  to: 17, step: 1 },
        dom:    { mode: 'every', n: 2,  values: [], from: 1,  to: 15, step: 1 },
        month:  { mode: 'every', n: 3,  values: [], from: 1,  to: 6,  step: 1 },
        dow:    { mode: 'every', n: 1,  values: [], from: 1,  to: 5,  step: 1 },
      };
      FIELDS.forEach(f => {
        Object.assign(state[f], defaults[f]);

        document.querySelectorAll(`.mode-btn[data-field="${f}"]`)
          .forEach(b => b.classList.remove('active'));
        document.querySelector(`.mode-btn[data-field="${f}"][data-mode="every"]`)
          ?.classList.add('active');

        renderFieldInputs(f);
      });
      refresh();
    });

    // ── Init ──────────────────────────────────────────────────────────────────
    FIELDS.forEach(f => renderFieldInputs(f));
    refresh();
  </script>

  <style>
    /* ── Shared layout (mirrors other tools) ─────────────────────────────── */
    .container-page {
      background: black;
      max-width: 80rem;
      margin-inline: auto;
      padding-inline: 1rem;
    }
    .card              { background: white; border: 1px solid #e5e7eb; border-radius: .5rem; }
    .card-body         { padding: 1rem; }
    .section-title     { text-transform: uppercase; font-size: .65rem; font-weight: 600; letter-spacing: .1em; color: #2563eb; }
    .field-preview     { min-height: 1.25rem; }

    /* ── Inputs ──────────────────────────────────────────────────────────── */
    .form-input {
      width: 100%; border: 1px solid #d1d5db; border-radius: .375rem;
      padding: .5rem .75rem; font-size: .875rem; outline: none;
      transition: border-color .2s;
    }
    .form-input:focus { border-color: #2563eb; }

    /* ── Buttons ─────────────────────────────────────────────────────────── */
    .btn-primary {
      border: 1px solid #2563eb; background: #2563eb; color: white;
      padding: .5rem 1rem; border-radius: .375rem; font-size: .75rem; cursor: pointer;
    }
    .btn-primary:hover { background: #1e40af; }

    .btn-secondary {
      border: 1px solid #d1d5db; background: white; color: #374151;
      padding: .5rem 1rem; border-radius: .375rem; font-size: .75rem; cursor: pointer;
    }
    .btn-secondary:hover { border-color: #2563eb; color: #2563eb; }
    .btn-secondary.active { background: #111827; color: white; border-color: #111827; }

    /* ── Mode buttons (field tabs) ──────────────────────────────────────── */
    .mode-btn {
      border: 1px solid #d1d5db; background: white; color: #374151;
      padding: .3rem .7rem; border-radius: .375rem; font-size: .7rem; cursor: pointer;
      transition: all .15s;
    }
    .mode-btn:hover        { border-color: #2563eb; color: #2563eb; }
    .mode-btn.active       { background: #1e3a8a; color: white; border-color: #1e3a8a; }

    /* ── Note box ─────────────────────────────────────────────────────────── */
    .note-box {
      display: none;
      padding: 1rem 1.5rem;
      background: #f8fafc;
      border-top: 1px solid #e5e7eb;
      font-size: .8rem;
      color: #374151;
      line-height: 1.65;
    }
    /* Inner note classes — :global() because injected via innerHTML at runtime */
    :global(.note-box p) { margin-bottom: .65rem; }
    :global(.note-box p:last-child) { margin-bottom: 0; }
    :global(.note-box code) {
      background: #e5e7eb; padding: 1px 5px; border-radius: 3px;
      font-size: .75rem; font-family: monospace;
    }
    :global(.note-box pre.note-code) {
      background: #1e293b; color: #94a3b8;
      padding: .6rem 1rem; border-radius: .375rem;
      font-size: .72rem; overflow-x: auto; margin: .5rem 0;
    }
    :global(.note-title) {
      font-weight: 700; font-size: .82rem; color: #111827;
      margin-bottom: .4rem !important;
    }
    :global(.note-caveat) {
      background: #fffbeb; border: 1px solid #fde68a;
      border-radius: .375rem; padding: .5rem .75rem; color: #92400e;
    }
    :global(.note-caveat code) { background: #fef3c7; }
    :global(.note-links-heading) {
      font-weight: 600; font-size: .75rem; color: #6b7280;
      text-transform: uppercase; letter-spacing: .05em;
      margin-top: .75rem !important; margin-bottom: .25rem !important;
    }
    :global(.note-links) {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: .2rem;
    }
    :global(.note-links li) { font-size: .78rem; color: #4b5563; }
    :global(.note-links a) {
      color: #2563eb; text-decoration: none; font-weight: 500;
    }
    :global(.note-links a:hover) { text-decoration: underline; }

    /* ── Toggle buttons (specific value pickers) — :global() because created via JS ── */
    :global(.toggle-btn) {
      border: 1px solid #d1d5db; background: white; color: #6b7280;
      padding: .25rem .3rem; border-radius: .25rem; font-size: .7rem;
      font-family: monospace; cursor: pointer; text-align: center;
      transition: all .15s;
    }
    :global(.toggle-btn:hover)    { border-color: #2563eb; color: #2563eb; }
    :global(.toggle-btn.selected) { background: #2563eb; color: white; border-color: #2563eb; }

    /* ── Expression display colours ──────────────────────────────────────── */
    .part-minute { color: #60a5fa; }   /* blue-400   */
    .part-hour   { color: #a78bfa; }   /* violet-400 */
    .part-dom    { color: #34d399; }   /* emerald-400 */
    .part-month  { color: #fbbf24; }   /* amber-400  */
    .part-dow    { color: #f87171; }   /* red-400    */
  </style>
</Layout>
