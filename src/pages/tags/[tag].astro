---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/base.astro';
import Hero from '../../components/hero.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const allTutorials = await getCollection('tutorials');
  const allContent = [...allPosts, ...allTutorials];

  const uniqueTags = [...new Set(allContent.flatMap((item) => item.data.tags || []))];

  return uniqueTags.map((tag) => {
    const filteredContent = allContent.filter(
      (item) => item.data.tags && item.data.tags.includes(tag)
    );
    return {
      params: { tag },
      props: { items: filteredContent },
    };
  });
}

const { tag } = Astro.params;
const { items } = Astro.props;
---

<Layout title={`Tag: ${tag}`}>
  <Hero title={`Tagged: ${tag}`} subtitle="Explore articles and tutorials on this topic." />
  
  <section class="py-14 px-6 bg-gray-950 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <a href="/blog" class="text-gray-400 hover:text-white transition-colors duration-200">
          ← Back to all posts
        </a>
      </div>

      <div class="grid gap-6">
        {items.map((entry) => {
          const isTutorial = entry.collection === 'tutorials';
          return (
            <a
              href={`/${entry.collection}/${entry.id}`}
              class={`group block bg-gray-900 rounded-xl border border-gray-700 border-l-4 ${isTutorial ? 'border-l-emerald-500' : 'border-l-indigo-500'} p-6 hover:shadow-xl hover:border-gray-600 transition-all duration-300`}
            >
              <div class="flex items-center gap-2 mb-2">
                <h3 class={`text-xl font-bold text-white ${isTutorial ? 'group-hover:text-emerald-400' : 'group-hover:text-indigo-400'} transition-colors duration-200`}>
                  {entry.data.title}
                </h3>
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${isTutorial ? 'bg-emerald-900 text-emerald-300 border border-emerald-700' : 'bg-indigo-900 text-indigo-300 border border-indigo-700'}`}>
                  {isTutorial ? 'Tutorial' : 'Post'}
                </span>
              </div>
              <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-3">
                {entry.data.date.toLocaleDateString('en-GB', {
                  year: 'numeric', month: 'long', day: 'numeric'
                })}
              </p>
              {entry.data.description && (
                <p class="text-gray-400 text-sm leading-relaxed mb-4">{entry.data.description}</p>
              )}
              {entry.data.tags && entry.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {entry.data.tags.map((t) => (
                    <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${t === tag ? (isTutorial ? 'bg-emerald-600 text-white border-emerald-500' : 'bg-indigo-600 text-white border-indigo-500') : 'bg-gray-800 text-gray-400 border-gray-700'}`}>
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </section>

</Layout>