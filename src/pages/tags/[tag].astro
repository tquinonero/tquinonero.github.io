---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/base.astro';
import Hero from '../../components/hero.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  // Ensure we operate on string arrays
  const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))];

  return uniqueTags.map((tag) => {
    // Filter posts that have tags, then check inclusion
    const filteredPosts = allPosts.filter((post) => post.data.tags && post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`Tag: ${tag}`}>
  <Hero title={`Posts tagged: ${tag}`} subtitle="Explore articles on this topic." />
  
  <section class="py-14 px-6 bg-gray-950 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <a href="/blog" class="text-gray-400 hover:text-white transition-colors duration-200">
          ← Back to all posts
        </a>
      </div>

      <div class="grid gap-6">
        {posts.map((entry) => (
          <a
            href={`/posts/${entry.id}`}
            class="group block bg-gray-900 rounded-xl border border-gray-700 border-l-4 border-l-indigo-500 p-6 hover:shadow-xl hover:border-gray-600 transition-all duration-300"
          >
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors duration-200">
              {entry.data.title}
            </h3>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-3">
              {entry.data.date.toLocaleDateString('en-GB', {
                year: 'numeric', month: 'long', day: 'numeric'
              })}
            </p>
            {entry.data.description && (
              <p class="text-gray-400 text-sm leading-relaxed mb-4">{entry.data.description}</p>
            )}
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {entry.data.tags.map((t) => (
                  <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${t === tag ? 'bg-indigo-600 text-white border-indigo-500' : 'bg-gray-800 text-indigo-400 border-gray-700'}`}>
                    {t}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>