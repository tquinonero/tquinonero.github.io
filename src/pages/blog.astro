---
import Layout from '../layouts/base.astro';
import Hero from '../components/hero.astro';
import CTASection from '../components/ctaSection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog">
  <Hero title="Blog" subtitle="Insights and stories from the web." />
  <section class="py-14 px-6 bg-gray-950">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-10">Articles & things for nerds</h2>
      {posts.length === 0 && (
        <p class="text-gray-400">No posts yet. Check back soon!</p>
      )}
      <div class="grid gap-6">
        {posts.map((entry) => (
          <a
            href={`/posts/${entry.id}`}
            class="group block bg-gray-900 rounded-xl border border-gray-700 border-l-4 border-l-indigo-500 p-6 hover:shadow-xl hover:border-gray-600 transition-all duration-300"
          >
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors duration-200">
              {entry.data.title}
            </h3>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-3">
              {entry.data.date.toLocaleDateString('en-GB', {
                year: 'numeric', month: 'long', day: 'numeric'
              })}
            </p>
            {entry.data.description && (
              <p class="text-gray-400 text-sm leading-relaxed mb-4">{entry.data.description}</p>
            )}
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {entry.data.tags.map((tag) => (
                  <span class="text-xs font-semibold bg-gray-800 text-indigo-400 px-3 py-1 rounded-full border border-gray-700">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    </div>
  </section>
  <CTASection
    title="Get in Touch"
    content="Send me an email to tquinonero.web@gmail.com"
  />
</Layout>