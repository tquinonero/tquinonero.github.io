---
import Layout from '../layouts/base.astro';
import Hero from '../components/hero.astro';
import CTASection from '../components/ctaSection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Blog">
  <Hero title="Blog" subtitle="Insights and stories from the web." />
  <div class="p-8 max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-4">Latest Articles</h1>
    <div class="grid gap-6 mt-6">
      {posts.length === 0 && (
        <p class="text-gray-500">No posts yet. Check back soon!</p>
      )}
      {posts.map((entry) => (
        <a href={`/posts/${entry.id}`} class="block border rounded-xl p-6 hover:shadow-md transition">
          <h2 class="text-2xl font-semibold mb-2">{entry.data.title}</h2>
          <p class="text-sm text-gray-500 mb-2">
            {entry.data.date.toLocaleDateString('en-GB', {
              year: 'numeric', month: 'long', day: 'numeric'
            })}
          </p>
          {entry.data.description && (
            <p class="text-gray-700 mb-4">{entry.data.description}</p>
          )}
          {entry.data.tags && entry.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {entry.data.tags.map((tag) => (
                <span class="text-xs font-medium bg-gray-100 text-gray-600 px-3 py-1 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </div>
  <CTASection
    title="Get in Touch"
    content="Send me an email to tquinonero.web@gmail.com"
  />
</Layout>