---
import Layout from '../../layouts/base.astro';
import Hero from '../../components/hero.astro';
import { getCollection } from 'astro:content';

export const PAGE_SIZE = 6;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const sortedPosts = posts.sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  
  const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);
  
  return Array.from({ length: totalPages - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: {
      posts: sortedPosts.slice((i + 1) * PAGE_SIZE, (i + 2) * PAGE_SIZE),
      currentPage: i + 2,
      totalPages,
      totalItems: sortedPosts.length
    }
  }));
}

const { posts, currentPage, totalPages, totalItems } = Astro.props;
---

<Layout title={`Blog - Page ${currentPage}`}>
  <Hero title="Blog" subtitle="Insights and stories from the web." />
  <section class="py-14 px-6 bg-gray-950">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-white mb-10">Articles & things for nerds</h2>
      <div class="grid gap-6">
        {posts.map((entry) => (
          <article class="group relative bg-gray-900 rounded-xl border border-gray-700 border-l-4 border-l-indigo-500 p-6 hover:shadow-xl hover:border-gray-600 transition-all duration-300">
            <h3 class="text-xl font-bold text-white mb-2 group-hover:text-indigo-400 transition-colors duration-200">
              <a href={`/posts/${entry.id}`} class="before:absolute before:inset-0 focus:outline-none">
                {entry.data.title}
              </a>
            </h3>
            <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-3 relative z-10 pointer-events-none">
              {entry.data.date.toLocaleDateString('en-GB', {
                year: 'numeric', month: 'long', day: 'numeric'
              })}
            </p>
            {entry.data.description && (
              <p class="text-gray-400 text-sm leading-relaxed mb-4 relative z-10 pointer-events-none">{entry.data.description}</p>
            )}
            {entry.data.tags && entry.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 relative z-10">
                {entry.data.tags.map((tag) => (
                  <a
                    href={`/tags/${tag}`}
                    class="text-xs font-semibold bg-gray-800 text-indigo-400 px-3 py-1 rounded-full border border-gray-700 hover:bg-indigo-900 hover:text-white hover:border-indigo-500 transition-colors duration-200"
                  >
                    {tag}
                  </a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
      
      <div class="mt-12 flex justify-center gap-3">
        {currentPage > 2 && (
          <a href={`/blog/${currentPage - 1}`} class="px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700 hover:bg-indigo-600 hover:border-indigo-500 transition-colors">
            &larr; Previous
          </a>
        )}
        <a href="/blog" class="px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700 hover:bg-indigo-600 hover:border-indigo-500 transition-colors">
          Page 1
        </a>
        {currentPage < totalPages && (
          <a href={`/blog/${currentPage + 1}`} class="px-4 py-2 bg-gray-800 text-white rounded-lg border border-gray-700 hover:bg-indigo-600 hover:border-indigo-500 transition-colors">
            Next &rarr;
          </a>
        )}
      </div>
      
      <p class="text-center text-gray-500 text-sm mt-4">
        Page {currentPage} of {totalPages} ({totalItems} total posts)
      </p>
    </div>
  </section>
</Layout>