---
import Layout from '../layouts/base.astro';
import Card from '../components/card.astro';
import ToolCard from '../components/ToolCard.astro';
import TextSection from '../components/textSection.astro';
import Hero from '../components/hero.astro';
import StatsCounter from '../components/StatsCounter.astro';
const stats = [
  { label: 'Projects completed', value: 46 },
  { label: 'Clients helped', value: 10 },
  { label: 'Free tools built', value: 9 },
];
---
		<Layout>
			<Hero 
				title="WordPress & Astro Web Developer"
				subtitle="Maintenance plans, security fixes, WordPress & Astro sites, and free tools for developers."
			/>

			<!-- Services — full width with dark background -->
			<section class="py-14 bg-gray-950">
				<div class="max-w-7xl mx-auto px-6">
					<h2 class="text-3xl font-bold mb-10 text-center text-white">My Services</h2>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						<Card 
							title="Maintenance for WordPress Sites" 
							subtitle="Maintenance Plans for WordPress" 
							content="Forget about updates, backups, and security. My WordPress maintenance plans ensure your site runs smoothly, stays secure, and performs at its best. Focus on your content while I handle the technical details."
						/>
						<Card 
							title="Fix Hacked WordPress" 
							subtitle="WordPress Security Fixes" 
							content="If your WordPress site has been compromised, I can help you clean it up and secure it against future attacks."
						/>
						<Card 
							title="Web Consulting" 
							subtitle="Web Consulting Services" 
							content="Web consulting focused on building reliable, scalable, and standards-compliant solutions. My work is grounded in web core principles, long-term maintainability, and performance-driven architecture."
						/>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
						<Card 
							title="Admin Lessons for WordPress Beginners" 
							subtitle="Get the Most Out of WordPress, One Lesson at a Time" 
							content="WordPress lessons focused on practical, real-world use. Sessions cover core concepts, Gutenberg, e-commerce, and structured workflows to help you build maintainable projects with confidence."
						/>
						<Card 
							title="Ecommerce Development" 
							subtitle="Ecommerce Development Services" 
							content="I build custom e-commerce solutions tailored to your business needs. From product catalogs to payment integrations, I ensure seamless shopping experiences that drive conversions."
						/>
						<Card 
							title="Membership Sites" 
							subtitle="Membership Site Development Services" 
							content="I build custom membership sites that provide secure, scalable access to exclusive content and services. From user registration to subscription management, I ensure seamless experiences for your members."
						/>
					</div>
				</div>
			</section>

			<!-- Stats -->
			<section class="py-14 bg-gray-950">
				<div class="max-w-5xl mx-auto px-6">
					<h2 class="text-3xl font-bold mb-10 text-center text-white">Things I Have Done</h2>
					<StatsCounter stats={stats} />
				</div>
			</section>

			<!-- Tools -->
			<section class="py-14 bg-gray-900 border-t border-gray-800 transition-colors">
				<div class="max-w-7xl mx-auto px-6">
					<h2 class="text-3xl font-bold mb-10 text-center text-white">Free Tools & Open Source</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
						<ToolCard 
							title="WC Loop Variations" 
							subtitle="New WordPress Plugin" 
							content="Display WooCommerce variations inside product loops (FSE / Query Loop compatible). A block-based solution for modern WordPress themes available on GitHub."
                            href="https://github.com/tquinonero/Loop-Variations-Block-for-Wocommerce"
                            isExternal={true}
						/>
						<ToolCard 
							title="Typography Calculator" 
							subtitle="WordPress Dev Tool" 
							content="Generate fluid font sizes for WordPress theme.json using clamp(). Visualize scaling across viewports instantly."
                            href="/theme-typography-calculator"
						/>
						<ToolCard 
							title="Social Card Generator" 
							subtitle="SEO Tool" 
							content="Preview Open Graph images and generate meta tags. Ensure your content looks perfect when shared on social media."
                            href="/social-card-generator"
						/>
                        <ToolCard 
							title="Cron Expression Builder" 
							subtitle="Utility" 
							content="Visually build and test cron expressions for scheduling tasks. A helper for setting up automated server jobs."
                            href="/cron-expression-builder"
						/>
                        <ToolCard 
							title="Regex Tester" 
							subtitle="Developer Utility" 
							content="Test regular expressions with real-time feedback. Includes common patterns for validation and extraction."
                            href="/regex-tester"
						/>
                         <ToolCard 
							title="Robots.txt Generator" 
							subtitle="SEO Utility" 
							content="Create perfect robots.txt files for your site. Control how search engines crawl and index your content."
                            href="/robots-txt-generator"
						/>
                        <ToolCard 
							title="Color Palette Generator" 
							subtitle="Design Tool" 
							content="Create harmonious color schemes for your projects. Export palettes to CSS, SCSS, or Tailwind config."
                            href="/color-palette-generator"
						/>
                        <ToolCard 
							title="WordPress Quiz" 
							subtitle="Knowledge Check" 
							content="Test your knowledge of WordPress development, hooks, and architecture with this interactive quiz."
                            href="/wordpress-quiz"
						/>
                         <ToolCard 
							title="Frontmatter Generator" 
							subtitle="Content Tool" 
							content="Generate Markdown frontmatter for your blog posts. Streamline your content creation workflow."
                            href="/frontmatter-generator"
						/>
						<ToolCard 
							title="Custom AJAX Search"
							subtitle="Search plugin for WordPress, revisited"
							content="Search in all custom post types and display results with AJAX"
							href="https://github.com/tquinonero/AJAX-Search"
							isExternal={true}
						/>
						<ToolCard 
							title="WC Missing Short Descriptions"
							subtitle="Plugin for WooCommerce Admin Area"
							content="Identify WooCommerce products missing short descriptions. Lists products, thumbnails, SKUs, and provides quick edit links. Polylang compatible."
							href="https://github.com/tquinonero/WC-Missing-Short-Descriptions"
							isExternal={true}
						/>
					</div>
				</div>
			</section>

			<!-- Code Snippets callout -->
			<section class="bg-gray-950">
				<div class="max-w-5xl mx-auto px-6">
					<TextSection 
						heading="Code Snippets for WordPress"
						paragraph="Discover a collection of practical code snippets for development in WordPress. From custom functions to performance optimizations, these snippets are designed to help you build better WordPress sites with ease."
						buttonText="Browse Snippets on GitHub"
						buttonLink="https://github.com/tquinonero/WP-Snippets"
					/>
				</div>
			</section>

		</Layout>
