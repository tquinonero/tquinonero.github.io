---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Navbar from '../components/navbar.astro';

interface Props {
  title?: string;
}

const { title = 'Astro Website' } = Astro.props;
const pathname = Astro.url.pathname;
let currentPage = 'index';
if (pathname.includes('/about')) currentPage = 'about';
if (pathname.includes('/contact')) currentPage = 'contact';
if (pathname.includes('/blog')) currentPage = 'blog';
if (pathname.includes('/frontmatter-generator')) currentPage = 'frontmatter-generator';
if (pathname.includes('/wordpress-quiz')) currentPage = 'wordpress-quiz';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="google-site-verification" content="k1WKNTc7JScK2OXSMwhdX-LzEEO7XalnBS2r0E861FE" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
	</head>

    <body>
        <Navbar currentPage={currentPage} />
        <slot />
    </body>
</html> 