---
import BaseLayout from './base.astro';
import Hero from '../components/hero.astro';
import CtaSection from '../components/ctaSection.astro';
import { SITE_CONFIG } from '../config';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    author?: string;
    description?: string;
    tags?: string[];
  };
}

const { frontmatter } = Astro.props;
const { title, date, author, description, tags = [] } = frontmatter;

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<BaseLayout title={title} description={description}>
  <Hero
    title="Blog about WP and stuff"
    subtitle="Insights, tips, and stories from the web."
  />
  <!-- Post Header -->
  <div class="max-w-3xl mx-auto px-4 pt-12 pb-6">
    {tags.length > 0 && (
      <div class="flex gap-2 mb-4">
        {tags.map((tag: string) => (
          <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full">{tag}</span>
        ))}
      </div>
    )}
    <h1 class="text-4xl font-bold leading-tight mb-4">{title}</h1>
    <p class="text-gray-500 text-sm">
      By <span class="font-medium text-gray-700">{author || 'Anonymous'}</span> · {formattedDate}
    </p>
  </div>
  <!-- Post Content -->
  <main>
    <article class="prose prose-lg prose-slate max-w-3xl mx-auto px-4 pb-16 prose-headings:font-bold prose-h2:text-2xl prose-a:text-blue-600 prose-img:rounded-xl">
      <slot />
    </article>
  </main>
  <CtaSection
    title="Enjoyed the post? Let's Connect!"
    content="If you found this post helpful, consider subscribing to my newsletter for more insights and tips on WordPress development. Stay updated with the latest trends and best practices in the web development world."
  />
</BaseLayout>