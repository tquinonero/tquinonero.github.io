---
import BaseLayout from './base.astro';
import Hero from '../components/hero.astro';

interface Props {
  frontmatter: {
    title: string;
    date: Date;
    author?: string;
    description?: string;
    tags?: string[];
    image?: string;
    updatedDate?: Date;
  };
}

const { frontmatter } = Astro.props;
const { title, date, author, description, tags = [], image, updatedDate } = frontmatter;

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description: description ?? '',
  datePublished: new Date(date).toISOString(),
  ...(updatedDate && { dateModified: new Date(updatedDate).toISOString() }),
  author: {
    '@type': 'Person',
    name: author ?? 'Toni Q',
  },
  url: Astro.url.toString(),
  publisher: {
    '@type': 'Person',
    name: 'Tquinonero',
    url: 'https://tquinonero.github.io',
  },
  ...(image && { image }),
};
---

<BaseLayout title={title} description={description} ogType="article" ogImage={image}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Hero
    title="Tutorials"
    subtitle="Step-by-step guides for WordPress and web development."
  />

  <!-- Tutorial Header -->
  <div class="max-w-3xl mx-auto px-4 pt-12 pb-6">
    {tags.length > 0 && (
      <div class="flex gap-2 flex-wrap mb-4">
        {tags.map((tag: string) => (
          <a
            href={`/tags/${tag}`}
            class="text-xs bg-warm-800 text-warm-200 px-2 py-1 rounded-full hover:bg-warm-700 transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
    <h1 class="text-4xl font-bold leading-tight mb-4">{title}</h1>
    <p class="text-warm-500 text-sm">
      By <span class="font-medium text-warm-300">{author ?? 'Anonymous'}</span> ·{' '}
      <time datetime={new Date(date).toISOString()}>{formattedDate}</time>
    </p>
  </div>

  <!-- Tutorial Content -->
  <article class="prose prose-lg prose-invert max-w-3xl mx-auto px-4 pb-16 prose-headings:font-bold prose-h2:text-2xl prose-a:text-accent prose-img:rounded-xl">
    <slot />
  </article>
</BaseLayout>
