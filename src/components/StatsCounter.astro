---
// File: src/components/StatsCounter.astro
type Stat = {
  label: string;
  value: number;
};

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props as Props;
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
  {stats.map((stat: Stat, index: number) => (
    <div class="text-center">
      <span
        class="text-4xl font-bold text-white counter"
        data-target={stat.value.toString()}
        style="opacity:0;"
      >
        0
      </span>
      <p class="mt-2 text-lg font-medium text-gray-300">{stat.label}</p>
    </div>
  ))}
</div>

<script>
  let triggered = false;

  function animateCounters() {
    // Re-query counters each time to handle View Transitions
    const counters = document.querySelectorAll('.counter') as NodeListOf<HTMLSpanElement>;
    const triggerPoint = window.innerHeight * 0.8;

    counters.forEach((counter) => {
      const rect = counter.getBoundingClientRect();
      if (rect.top <= triggerPoint) {
        triggered = true;

        counters.forEach((c, idx) => {
          const target = parseInt(c.dataset.target!);
          const duration = 2000;
          const startTime = performance.now();

          function update(now: number) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            c.textContent = Math.floor(progress * target).toString();
            c.style.opacity = progress.toString();

            if (progress < 1) {
              requestAnimationFrame(update);
            } else {
              c.textContent = target.toString();
            }
          }

          setTimeout(() => requestAnimationFrame(update), idx * 200);
        });
      }
    });
  }

  // Handle both initial load and View Transition navigations
  document.addEventListener('astro:page-load', () => {
    animateCounters();
  });
</script>