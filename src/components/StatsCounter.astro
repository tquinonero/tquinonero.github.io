---
// File: src/components/StatsCounter.astro
type Stat = {
  label: string;
  value: number;
};

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props as Props;
---

<div class="grid grid-cols-2 gap-8">
  {stats.map((stat: Stat, index: number) => (
    <div class="text-center">
      <span
        class="text-4xl font-bold text-white counter"
        data-target={stat.value.toString()}
        style="opacity:0;"
      >
        0
      </span>
      <p class="mt-2 text-lg font-medium text-gray-300">{stat.label}</p>
    </div>
  ))}
</div>

<script>
  // Cast NodeList elements to HTMLSpanElement for TS safety
  const counters = document.querySelectorAll('.counter') as NodeListOf<HTMLSpanElement>;
  let triggered = false;

  function animateCounters() {
    if (triggered) return;

    const triggerPoint = window.innerHeight * 0.8;

    counters.forEach((counter, i) => {
      const rect = counter.getBoundingClientRect();
      if (rect.top <= triggerPoint) {
        triggered = true;

        counters.forEach((c, idx) => {
          const target = parseInt(c.dataset.target!); // dataset is defined
          const duration = 2000; // 2 seconds
          const startTime = performance.now();

          function update(now: number) { // type 'now' properly
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            c.textContent = Math.floor(progress * target).toString(); // convert number -> string
            c.style.opacity = progress.toString(); // convert number -> string

            if (progress < 1) {
              requestAnimationFrame(update);
            } else {
              c.textContent = target.toString();
            }
          }

          // Stagger start by 200ms each
          setTimeout(() => requestAnimationFrame(update), idx * 200);
        });
      }
    });
  }

  window.addEventListener('scroll', animateCounters);
  window.addEventListener('load', animateCounters);
</script>