---
import { Image } from 'astro:assets';
import car from '../car.jpg';

interface Props {
  title: string;
  subtitle: string;
  content: string;
}

const { title, subtitle, content } = Astro.props;
---

<div class="bg-black border border-black shadow-lg p-6 rounded-lg relative overflow-hidden group">
  <!-- Background Image -->
  <div class="absolute inset-0 bg-cover bg-center bg-no-repeat opacity-15 group-hover:opacity-10 transition-opacity duration-300" style={`background-image: url(${car.src}); background-size: cover; background-position: center;`}></div>
  
  <!-- Content -->
  <div class="relative z-10">
    <h2 class="text-white text-2xl font-bold mb-2">{title}</h2>
    <h3 class="text-white text-lg font-semibold mb-4">{subtitle}</h3>
    <p class="text-white">{content}</p>
  </div>
</div>