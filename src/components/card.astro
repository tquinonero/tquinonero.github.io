---
interface Props {
  title: string;
  subtitle: string;
  content: string;
}

const { title, subtitle, content } = Astro.props;
---

<div class="relative bg-gray-900 border border-gray-700 border-l-4 border-l-blue-500 rounded-lg p-6 overflow-hidden group transition-all duration-300 hover:border-gray-600 hover:shadow-xl hover:-translate-y-0.5">
  <!-- Subtle radial glow texture -->
  <div class="absolute -top-8 -left-8 w-36 h-36 rounded-full bg-blue-600/10 blur-2xl pointer-events-none group-hover:bg-blue-500/20 transition-opacity duration-300"></div>

  <!-- Content -->
  <div class="relative z-10">
    <h2 class="text-white text-xl font-bold mb-1">{title}</h2>
    <h3 class="text-blue-400 text-sm font-semibold uppercase tracking-wide mb-3">{subtitle}</h3>
    <p class="text-gray-400 text-sm leading-relaxed">{content}</p>
  </div>
</div>