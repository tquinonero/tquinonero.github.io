---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const links = [
  { href: '/', label: 'Home', code: 'index', active: currentPage === 'index' },
  { href: '/cdw', label: 'CDW', code: 'cdw', active: currentPage === 'cdw' },
  { href: '/about', label: 'About', code: 'about', active: currentPage === 'about' },
  { href: '/blog', label: 'Blog', code: 'blog', active: currentPage === 'blog' },
  { href: '/tutorials', label: 'Tutorials', code: 'tutorials', active: currentPage === 'tutorials' },
];

const tools = [
  { href: '/frontmatter-generator', label: 'Frontmatter Generator', code: 'frontmatter-generator', active: currentPage === 'frontmatter-generator' },
  { href: '/wordpress-quiz', label: 'WordPress Quiz', code: 'wordpress-quiz', active: currentPage === 'wordpress-quiz' },
  { href: '/regex-tester', label: 'Regex Tester', code: 'regex-tester', active: currentPage === 'regex-tester' },
  { href: '/color-palette-generator', label: 'Color Palette Generator', code: 'color-palette-generator', active: currentPage === 'color-palette-generator' },
  { href: '/cron-expression-builder', label: 'Cron Expression Builder', code: 'cron-expression-builder', active: currentPage === 'cron-expression-builder' },
  { href: '/robots-txt-generator', label: 'Robots.txt Generator', code: 'robots-txt-generator', active: currentPage === 'robots-txt-generator' },
  { href: '/theme-typography-calculator', label: 'Theme.json Typography', code: 'theme-typography-calculator', active: currentPage === 'theme-typography-calculator' },
  { href: '/social-card-generator', label: 'Social Card Generator', code: 'social-card-generator', active: currentPage === 'social-card-generator' },
];

const toolsActive = tools.some(t => t.code === currentPage);
---

<nav class="bg-warm-900 text-warm-100 shadow-lg sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo/Brand -->
      <div class="flex-shrink-0">
        <a href="/" class="text-2xl font-bold hover:opacity-80 transition-opacity duration-300 flex items-baseline gap-0">
            <span class="bg-gradient-to-r from-accent to-accent-light bg-clip-text text-transparent">tquinonero</span><span class="text-accent font-light">.dev</span>
          </a>
      </div>

      <!-- Navigation Links -->
      <!-- Desktop Menu -->
      <div class="hidden md:flex space-x-1 items-center">
        {links.map(link => (
          <a
            href={link.href}
            class={`px-4 py-2 rounded-lg font-medium transition-all duration-300 ${
              link.active
                ? 'bg-accent text-warm-950 shadow-md shadow-accent/20'
                : 'text-warm-300 hover:bg-warm-800 hover:text-warm-100'
            }`}
          >
            {link.label}
          </a>
        ))}

        <!-- Tools Dropdown -->
        <div class="group relative py-2">
          <button
            class={`px-4 py-2 rounded-lg font-medium transition-all duration-300 flex items-center gap-1 ${
              toolsActive
                ? 'bg-accent text-warm-950 shadow-md shadow-accent/20'
                : 'text-warm-300 group-hover:bg-warm-800'
            }`}
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75a4.5 4.5 0 0 1-4.884 4.484c-1.076-.091-2.264.071-2.95.904l-7.152 8.684a2.548 2.548 0 1 1-3.586-3.586l8.684-7.152c.833-.686.995-1.874.904-2.95a4.5 4.5 0 0 1 6.336-4.486l-3.276 3.276a3.004 3.004 0 0 0 2.25 2.25l3.276-3.276c.256.565.398 1.192.398 1.852Z" />
            </svg>
            Free Tools
            <svg class="w-3.5 h-3.5 shrink-0 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div class="absolute right-0 mt-2 w-64 bg-warm-800 rounded-lg shadow-xl border border-warm-700 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right z-50">
            <div class="py-1">
              {tools.map(tool => (
                <a
                  href={tool.href}
                  class={`block px-4 py-2.5 text-sm font-medium transition-colors duration-200 border-l-2 ${
                    tool.active
                      ? 'bg-warm-700/50 text-accent border-accent'
                      : 'border-transparent text-warm-300 hover:bg-warm-700 hover:text-warm-100'
                  }`}
                >
                  {tool.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-warm-300 hover:text-warm-100 p-2 focus:outline-none" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-warm-900 border-t border-warm-800">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
      {links.map(link => (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-md text-base font-medium ${
            link.active
              ? 'bg-accent text-warm-950'
              : 'text-warm-300 hover:bg-warm-800 hover:text-warm-100'
          }`}
        >
          {link.label}
        </a>
      ))}
      
      <!-- Mobile Tools Section -->
      <div class="pt-2 pb-1 border-t border-warm-800 mt-2">
        <div class="px-3 py-2 text-xs font-semibold text-warm-500 uppercase tracking-wider">
          Free Tools
        </div>
        {tools.map(tool => (
          <a
            href={tool.href}
            class={`block px-3 py-2 rounded-md text-sm font-medium ${
              tool.active
                ? 'bg-accent text-warm-950'
                : 'text-warm-400 hover:bg-warm-800 hover:text-warm-100'
            }`}
          >
            {tool.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!menu.contains(target) && !btn.contains(target) && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
      }
    });
  }
</script>