---
interface Props {
  title?: string;
  content?: string;
}

const { 
  title = "Get in Touch", 
  content = "send an email to tquinonero.web@gmail.com" 
} = Astro.props;
---

<section class="py-12 px-8 text-white bg-gray-900">
  <div class="max-w-4xl mx-auto text-center">
    {title && <h2 class="text-3xl font-bold mb-4">{title}</h2>}
    <p class="text-lg">{content}</p>
  </div>
</section>