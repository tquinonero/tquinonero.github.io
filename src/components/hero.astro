---
import { Image } from 'astro:assets';
import defaultBg from '../codioful-formerly-gradienta-unsplash.jpg';
import Button from './Button.astro';
import { SITE_CONFIG } from '../config';

interface Props {
  backgroundImage?: any;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  backgroundImage = defaultBg,
  title,
  subtitle,
  ctaText,
  ctaHref = `mailto:${SITE_CONFIG.email}`
} = Astro.props;
---

<section class="relative bg-gradient-to-r from-purple-600 to-blue-600 h-[50vh] text-white overflow-hidden">
  <div class="absolute inset-0">
    <Image
      src={backgroundImage}
      alt=""
      class="object-cover object-center w-full h-full"
      widths={[640, 1024, 1280, 1920]}
      sizes="100vw"
      quality={80}
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black opacity-50"></div>
  </div>

  <div class="relative z-10 flex flex-col justify-center items-center h-full text-center px-4">
    {title && <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">{title}</h1>}
    {subtitle && <p class="text-lg md:text-xl text-gray-300 mb-8">{subtitle}</p>}
    <Button text="Have a project? Let's go" href="mailto:tquinonero.web@gmail.com" />
    {ctaText && (
      <a
        href={ctaHref}
        class="bg-yellow-400 text-gray-900 hover:bg-yellow-300 py-2 px-6 rounded-full text-lg font-semibold transition duration-300 ease-in-out transform hover:scale-105 hover:shadow-lg"
      >
        {ctaText}
      </a>
    )}
  </div>
</section>