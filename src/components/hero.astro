---
interface Props {
  backgroundImage: any;
  title?: string;
  subtitle?: string;
}
const { backgroundImage, title, subtitle } = Astro.props;
---

<section
  class="relative h-[40vh] flex items-center justify-center bg-cover bg-center bg-no-repeat overflow-hidden"
  style={`background-image: url(${backgroundImage.src});`}
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/40 animate-overlay"></div>

  <!-- Content -->
  <div class="relative z-10 text-center text-white">
    {title && <h1 class="text-4xl md:text-5xl font-bold mb-4 animate-slide-up">{title}</h1>}
    {subtitle && <p class="text-lg md:text-xl animate-slide-up animation-delay-200">{subtitle}</p>}
  </div>
</section>

<style>
  /* Overlay fades in */
  @keyframes overlayFadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Content slides up and fades in */
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Subtle background zoom */
  section {
    animation: bgZoom 8s ease-out forwards;
  }

  @keyframes bgZoom {
    from { background-size: 110%; }
    to   { background-size: 100%; }
  }

  .animate-overlay {
    animation: overlayFadeIn 1s ease-out forwards;
  }

  .animate-slide-up {
    opacity: 0;
    animation: slideUp 0.8s ease-out forwards;
    animation-delay: 0.3s;
  }

  .animation-delay-200 {
    animation-delay: 0.55s;
  }
</style>