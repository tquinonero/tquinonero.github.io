---
import Button from './Button.astro';
import { SITE_CONFIG } from '../config';

interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref = `mailto:${SITE_CONFIG.email}`
} = Astro.props;
---

<section class="relative bg-warm-950 text-warm-100 overflow-hidden min-h-[50vh]">

  <!-- Hero background -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#1c1917] via-[#292524] to-[#1c1917]" style="z-index:1;"></div>

  <div class="absolute inset-0 z-10 flex flex-col justify-center items-center text-center px-4">
    {title && <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">{title}</h1>}
    {subtitle && <p class="text-lg md:text-xl font-semibold text-warm-300 mb-8">{subtitle}</p>}
    {ctaText ? (
      <a
        href={ctaHref}
        class="bg-accent text-warm-950 hover:bg-accent-hover py-2 px-6 rounded-full text-lg font-semibold transition duration-300 ease-in-out transform hover:scale-105 hover:shadow-lg"
      >
        {ctaText}
      </a>
    ) : (
      <Button text="Have a project? Let's go" href={ctaHref} />
    )}
  </div>
</section>