---
interface Props {
  title: string;
  description: string;
  badge?: string;
  badgeColor?: 'blue' | 'purple' | 'green' | 'yellow';
  reverse?: boolean;
}

const { title, description, badge, badgeColor = 'blue', reverse = false } = Astro.props;

const badgeColorClasses: Record<string, string> = {
  blue:   'bg-blue-500/10 text-blue-400 border-blue-500/30',
  purple: 'bg-purple-500/10 text-purple-400 border-purple-500/30',
  green:  'bg-green-500/10 text-green-400 border-green-500/30',
  yellow: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/30',
};

const glowColorClasses: Record<string, string> = {
  blue:   'bg-blue-600/20',
  purple: 'bg-purple-600/20',
  green:  'bg-green-600/20',
  yellow: 'bg-yellow-600/20',
};
---

<div class={`flex flex-col ${reverse ? 'md:flex-row-reverse' : 'md:flex-row'} gap-8 md:gap-12 items-start`}>
  <!-- Icon / visual side -->
  <div class="flex-shrink-0 w-full md:w-14">
    <div class={`relative w-14 h-14 rounded-2xl border border-gray-700 flex items-center justify-center overflow-hidden`}>
      <div class={`absolute inset-0 ${glowColorClasses[badgeColor]} blur-xl`}></div>
      <div class="relative z-10">
        <slot name="icon" />
      </div>
    </div>
  </div>

  <!-- Text side -->
  <div class="flex-1">
    {badge && (
      <span class={`inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full border mb-3 ${badgeColorClasses[badgeColor]}`}>
        {badge}
      </span>
    )}
    <h3 class="text-2xl font-bold text-white mb-3">{title}</h3>
    <p class="text-gray-400 leading-relaxed text-base">
      {description}
    </p>
    <slot name="extra" />
  </div>
</div>
