---
interface Props {
  title?: string;
  content: string;
}

const { title, content } = Astro.props;
---

<section class="py-12 px-8 text-white bg-gray-900">
  <div class="max-w-4xl mx-auto text-center">
    {title && <h2 class="text-3xl font-bold mb-4">{title}</h2>}
    <p class="text-lg">{content}</p>
  </div>
</section>