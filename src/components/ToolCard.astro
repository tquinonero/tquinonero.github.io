---
interface Props {
  title: string;
  subtitle: string;
  content: string;
  href: string;
  isExternal?: boolean;
}

const { title, subtitle, content, href, isExternal = false } = Astro.props;

const Component = 'a';
const props = { 
  href, 
  target: isExternal ? '_blank' : undefined, 
  rel: isExternal ? 'noopener noreferrer' : undefined 
};
---

<Component {...props} class="block relative bg-warm-900 border border-warm-700 border-l-4 border-l-accent rounded-lg p-6 overflow-hidden group transition-all duration-300 hover:border-accent hover:shadow-xl hover:-translate-y-0.5 cursor-pointer">
  <!-- Subtle radial glow texture -->
  <div class="absolute -top-8 -left-8 w-36 h-36 rounded-full bg-accent/10 blur-2xl pointer-events-none group-hover:bg-accent/20 transition-opacity duration-300"></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col h-full">
    <h2 class="text-warm-100 text-xl font-bold mb-1 group-hover:text-accent transition-colors">{title}</h2>
    <h3 class="text-accent text-sm font-semibold uppercase tracking-wide mb-3">{subtitle}</h3>
    <p class="text-warm-400 text-sm leading-relaxed mb-4 flex-grow">{content}</p>
    
    <div class="mt-auto flex items-center text-accent text-sm font-medium opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-2 group-hover:translate-y-0">
        {isExternal ? (
           <span class="flex items-center gap-2">View on GitHub <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg></span>
        ) : (
           <span class="flex items-center gap-2">Open Tool <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></span>
        )}
    </div>
  </div>
</Component>