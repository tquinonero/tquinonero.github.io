---
import { SITE_CONFIG } from '../config';

interface Props {
  heading: string;
  paragraph: string;
}

const { heading, paragraph } = Astro.props;
---

<section class="py-12 px-8">
  <div>
    <!-- Heading -->
    <h3 class="text-3xl font-bold mb-8 text-center">{heading}</h3>
    
    <!-- Paragraph -->
    <p class="text-lg leading-relaxed mb-12 text-gray-700">
      {paragraph}
    </p>
     
    <!-- Button -->
    <div class="flex justify-center mt-8">
      <a 
        href={SITE_CONFIG.github}
        class="bg-black hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg shadow-lg transition duration-300 ease-in-out"
      >
        Take me to the code
      </a>
    </div>
  </div>
</section>